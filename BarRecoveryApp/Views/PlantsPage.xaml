<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarRecoveryApp.Views.PlantsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Plantas">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Gestión de Plantas"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- ActivityIndicator quitado: bug de renderizado en Android,
                 ver LoginPage.xaml para el detalle. -->

            <Border
                IsVisible="{Binding HasError}"
                Style="{StaticResource ErrorBanner}">

                <Label
                    Text="{Binding ErrorMessage}"
                    Style="{StaticResource ErrorBannerText}" />

            </Border>

            <Border
                IsVisible="{Binding HasSuccess}"
                Style="{StaticResource SuccessBanner}">

                <Label
                    Text="{Binding SuccessMessage}"
                    Style="{StaticResource SuccessBannerText}" />

            </Border>


            <Label
                Text="Datos de planta"
                FontSize="20"
                FontAttributes="Bold" />

            <Entry
                Text="{Binding Code}"
                Placeholder="Código ej: MAPA, ANA, SANTA_FE" />

            <Entry
                Text="{Binding Name}"
                Placeholder="Nombre ej: MAPA, ANA, Santa Fe" />

            <Editor
                Text="{Binding Description}"
                Placeholder="Descripción"
                AutoSize="TextChanges"
                HeightRequest="80" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    Text="Nueva"
                    Command="{Binding NewCommand}"
                    Style="{StaticResource OutlineButton}" />

                <Button
                    Grid.Column="1"
                    Text="{Binding SaveButtonText}"
                    Command="{Binding SaveCommand}" />
            </Grid>

            <BoxView HeightRequest="1" Color="#DDDDDD" Margin="0,12" />

            <Label
                Text="Plantas existentes"
                FontSize="20"
                FontAttributes="Bold" />

            <CollectionView
                ItemsSource="{Binding Plants}"
                SelectedItem="{Binding SelectedPlant}"
                SelectionMode="Single">


                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            Padding="12"
                            Margin="0,4"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            BackgroundColor="White">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>


                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="{Binding Name}"
                                    FontAttributes="Bold"
                                    FontSize="16" />

                                <Label
                                    Text="{Binding Code}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Label
                                    Text="{Binding IsActive, StringFormat='Activa: {0}'}"
                                    FontSize="13" />

                                <Label
                                    Text="{Binding Description}"
                                    FontSize="13"
                                    TextColor="Gray" />
                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button
                Text="Activar / Desactivar seleccionada"
                Command="{Binding ToggleActiveCommand}"
                Style="{StaticResource SecondaryButton}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>