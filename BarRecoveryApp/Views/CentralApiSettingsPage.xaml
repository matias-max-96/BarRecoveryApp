<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarRecoveryApp.Views.CentralApiSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Configuración de backend central">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Conexión al backend central"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Backend propio compartido entre las tablets (BarRecoveryApp.Api) — no tiene relación con la sincronización hacia Pomerium. La contraseña se guarda cifrada en el dispositivo y nunca se muestra de vuelta en pantalla."
                FontSize="12"
                TextColor="Gray"
                HorizontalTextAlignment="Center" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <Border
                IsVisible="{Binding HasError}"
                Padding="12"
                Stroke="#D9534F"
                StrokeThickness="1"
                BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#B00020"
                    FontAttributes="Bold" />
            </Border>

            <Border
                IsVisible="{Binding HasSuccess}"
                Padding="12"
                Stroke="#2E7D32"
                StrokeThickness="1"
                BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label
                    Text="{Binding SuccessMessage}"
                    TextColor="#2E7D32"
                    FontAttributes="Bold" />
            </Border>

            <Label
                Text="URL base"
                FontSize="13"
                TextColor="Gray" />
            <Entry
                Text="{Binding BaseUrl}"
                Placeholder="https://10.0.2.2:7123 (emulador) o IP de tu PC" />

            <Label
                Text="Usuario"
                FontSize="13"
                TextColor="Gray" />
            <Entry
                Text="{Binding Username}"
                Placeholder="piloto" />

            <Label
                Text="Contraseña (dejar en blanco para conservar la actual)"
                FontSize="13"
                TextColor="Gray" />
            <Entry
                Text="{Binding Password}"
                Placeholder="Contraseña"
                IsPassword="True" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    Text="Eliminar configuración"
                    Command="{Binding ClearCommand}"
                    BackgroundColor="#DC3545"
                    TextColor="White" />

                <Button
                    Grid.Column="1"
                    Text="Guardar"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#0D6EFD"
                    TextColor="White" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
