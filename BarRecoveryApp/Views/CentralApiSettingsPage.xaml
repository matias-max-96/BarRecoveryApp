<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarRecoveryApp.Views.CentralApiSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Configuración de backend central">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Conexión al backend central"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Backend propio compartido entre las tablets (BarRecoveryApp.Api) — no tiene relación con la sincronización hacia Pomerium. La contraseña se guarda cifrada en el dispositivo y nunca se muestra de vuelta en pantalla."
                FontSize="12"
                TextColor="Gray"
                HorizontalTextAlignment="Center" />

            <!-- ActivityIndicator quitado: bug de renderizado en Android,
                 ver LoginPage.xaml para el detalle. -->

            <Border
                IsVisible="{Binding HasError}"
                Style="{StaticResource ErrorBanner}">
                <Label
                    Text="{Binding ErrorMessage}"
                    Style="{StaticResource ErrorBannerText}" />
            </Border>

            <Border
                IsVisible="{Binding HasSuccess}"
                Style="{StaticResource SuccessBanner}">
                <Label
                    Text="{Binding SuccessMessage}"
                    Style="{StaticResource SuccessBannerText}" />
            </Border>

            <Label
                Text="URL base"
                FontSize="13"
                TextColor="Gray" />
            <Entry
                Text="{Binding BaseUrl}"
                Placeholder="https://10.0.2.2:7123 (emulador) o IP de tu PC" />

            <Label
                Text="Usuario"
                FontSize="13"
                TextColor="Gray" />
            <Entry
                Text="{Binding Username}"
                Placeholder="piloto" />

            <Label
                Text="Contraseña (dejar en blanco para conservar la actual)"
                FontSize="13"
                TextColor="Gray" />
            <Entry
                Text="{Binding Password}"
                Placeholder="Contraseña"
                IsPassword="True" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    Text="Eliminar configuración"
                    Command="{Binding ClearCommand}"
                    Style="{StaticResource DangerButton}" />

                <Button
                    Grid.Column="1"
                    Text="Guardar"
                    Command="{Binding SaveCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
