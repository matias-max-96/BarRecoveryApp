<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarRecoveryApp.Views.AuditExportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Exportar auditoría">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Exportar Auditoría"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Genera un archivo CSV local con las acciones realizadas en el rango seleccionado."
                FontSize="14"
                TextColor="Gray"
                HorizontalTextAlignment="Center" />

            <!-- ActivityIndicator quitado: bug de renderizado en Android,
                 ver LoginPage.xaml para el detalle. -->

            <Border
                IsVisible="{Binding HasError}"
                Style="{StaticResource ErrorBanner}">
                <Label
                    Text="{Binding ErrorMessage}"
                    Style="{StaticResource ErrorBannerText}" />
            </Border>

            <Border
                IsVisible="{Binding HasSuccess}"
                Style="{StaticResource SuccessBanner}">
                <Label
                    Text="{Binding SuccessMessage}"
                    Style="{StaticResource SuccessBannerText}" />
            </Border>

            <Label
                Text="Rango de fechas"
                FontSize="20"
                FontAttributes="Bold" />

            <Label Text="Desde" />
            <DatePicker Date="{Binding FromDate}" />

            <Label Text="Hasta" />
            <DatePicker Date="{Binding ToDate}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <Button
                    Grid.Column="0"
                    Text="Limpiar"
                    Command="{Binding ClearCommand}"
                    Style="{StaticResource OutlineButton}" />

                <Button
                    Grid.Column="1"
                    Text="Exportar CSV"
                    Command="{Binding ExportCommand}" />

            </Grid>

            <Label
                Text="Último archivo generado"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                Text="{Binding LastFileName}"
                FontSize="14"
                TextColor="Gray" />

            <Label
                Text="{Binding LastFilePath}"
                FontSize="12"
                TextColor="Gray"
                LineBreakMode="CharacterWrap" />

            <Button
                Text="Compartir auditoría"
                Command="{Binding ShareCommand}"
                Style="{StaticResource SecondaryButton}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>