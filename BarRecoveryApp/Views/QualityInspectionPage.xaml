<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarRecoveryApp.Views.QualityInspectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Inspección de calidad">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Inspección de Calidad"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <!-- Mensaje de error -->
            <Border
                IsVisible="{Binding HasError}"
                Padding="12"
                Margin="0,4"
                Stroke="#D9534F"
                StrokeThickness="1"
                BackgroundColor="White">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#B00020"
                    FontAttributes="Bold" />
            </Border>

            <!-- Mensaje de éxito -->
            <Border
                IsVisible="{Binding HasSuccess}"
                Padding="12"
                Margin="0,4"
                Stroke="#2E7D32"
                StrokeThickness="1"
                BackgroundColor="White">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Label
                    Text="{Binding SuccessMessage}"
                    TextColor="#2E7D32"
                    FontAttributes="Bold" />
            </Border>

            <!-- Filtros -->
            <Label
                Text="Filtros de búsqueda"
                FontSize="20"
                FontAttributes="Bold" />

            <Picker
                Title="Seleccione planta"
                ItemsSource="{Binding Plants}"
                SelectedItem="{Binding SelectedPlant}"
                ItemDisplayBinding="{Binding Name}" />

            <Picker
                Title="Seleccione tipo de barra"
                ItemsSource="{Binding BarTypes}"
                SelectedItem="{Binding SelectedBarType}"
                ItemDisplayBinding="{Binding Name}" />

            <Entry
                Text="{Binding SearchText}"
                Placeholder="Buscar por número, planta o tipo de barra"
                Keyboard="Text" />

            <Entry
                Text="{Binding RecoveryCountFilter}"
                Placeholder="Filtrar por número de recuperaciones"
                Keyboard="Numeric"/>

            <HorizontalStackLayout Spacing="8">
                <CheckBox
                    IsChecked="{Binding IncludeDisposed}" />

                <Label
                    Text="Incluir barras dadas de baja"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <Button
                    Grid.Column="0"
                    Text="Limpiar filtros"
                    Command="{Binding ClearFiltersCommand}"
                    BackgroundColor="#6C757D"
                    TextColor="White" />

                <Button
                    Grid.Column="1"
                    Text="Buscar barras"
                    Command="{Binding SearchCommand}"
                    BackgroundColor="#0D6EFD"
                    TextColor="White" />

            </Grid>

            <Label
                Text="{Binding ResultCountText}"
                FontSize="13"
                TextColor="Gray" />

            <BoxView
                HeightRequest="1"
                Color="#DDDDDD"
                Margin="0,8" />

            <!-- Resultados -->
            <Label
                Text="Barras encontradas"
                FontSize="20"
                FontAttributes="Bold" />

            <CollectionView
                ItemsSource="{Binding Bars}"
                SelectedItem="{Binding SelectedBar, Mode=TwoWay}"
                SelectionMode="Single">

                <CollectionView.EmptyView>
                    <Label
                        Text="No hay barras para mostrar. Use los filtros y presione Buscar barras."
                        TextColor="Gray"
                        HorizontalTextAlignment="Center"
                        Margin="0,24" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="12"
                            Margin="0,4"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            BackgroundColor="White">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="{Binding DisplayName}"
                                    FontAttributes="Bold"
                                    FontSize="16" />

                                <Label
                                    Text="{Binding RecoveryText}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Label
                                    Text="{Binding StatusText}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Label
                                    Text="{Binding PolicyText}"
                                    FontSize="13"
                                    TextColor="Gray" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView
                HeightRequest="1"
                Color="#DDDDDD"
                Margin="0,8" />

            <!-- Formulario de inspección -->
            <Label
                Text="Datos de inspección"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                Text="{Binding SelectedBarInfo}"
                FontSize="14"
                TextColor="Gray" />

            <Entry
                Text="{Binding RecoveryCount}"
                Placeholder="Recuperaciones acumuladas"
                Keyboard="Numeric" />
            
            <Label
                Text="Atributos técnicos"
                FontSize="20"
                FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding TechnicalAttributes}">
                <CollectionView.EmptyView>
                    <Label
                        Text="No hay atributos técnicos configurados para la barra seleccionada."
                        TextColor="Gray"
                        HorizontalTextAlignment="Center"
                        Margin="0,12" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="12"
                            Margin="0,4"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            BackgroundColor="White">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="8">

                                <Label
                                    Text="{Binding Name}"
                                    FontAttributes="Bold"
                                    FontSize="16" />

                                <Label
                                    Text="{Binding ToleranceText, StringFormat='Tolerancia: {0}'}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox IsChecked="{Binding WasMeasured}" />
                                    <Label
                                        Text="Medido / prueba realizada"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <!-- Entrada numérica/texto -->
                                <Entry
                                    Text="{Binding ValueText}"
                                    Placeholder="Valor medido"
                                    Keyboard="Numeric"
                                    IsVisible="{Binding ShowNumericInput}">

                                    <Entry.Triggers>
                                        <DataTrigger
                                            TargetType="Entry"
                                            Binding="{Binding IsOutOfRange}"
                                            Value="True">
                                            <Setter Property="BackgroundColor" Value="#FFF0F0" />
                                            <Setter Property="TextColor" Value="#B00020" />
                                        </DataTrigger>
                                    </Entry.Triggers>
                                </Entry>

                                <!-- Booleano Sí / No -->
                                <VerticalStackLayout 
                                    IsVisible="{Binding ShowBooleanInput}"
                                    Spacing="4">

                                    <HorizontalStackLayout Spacing="8">
                                        <CheckBox IsChecked="{Binding BooleanYes}" />
                                        <Label
                                            Text="Sí"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="8">
                                        <CheckBox IsChecked="{Binding BooleanNo}" />
                                        <Label
                                            Text="No"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                                <Label
                                    Text="{Binding StatusText}"
                                    TextColor="{Binding StatusColor}"
                                    FontSize="13" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <Label
                Text="Resultado de inspección"
                FontSize="20"
                FontAttributes="Bold" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox
                    IsChecked="{Binding CanBeRecovered}" />

                <Label
                    Text="Puede recuperarse nuevamente"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <CheckBox
                    IsChecked="{Binding IsApprovedForShipment}" />

                <Label
                    Text="Aprobada para envío"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <CheckBox
                    IsChecked="{Binding MustBeDisposed}" />

                <Label
                    Text="Dar de baja"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Editor
                Text="{Binding Notes}"
                Placeholder="Observaciones de calidad"
                AutoSize="TextChanges"
                HeightRequest="100" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <Button
                    Grid.Column="0"
                    Text="Limpiar inspección"
                    Command="{Binding ClearCommand}"
                    BackgroundColor="#6C757D"
                    TextColor="White" />

                <Button
                    Grid.Column="1"
                    Text="Guardar inspección"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#0D6EFD"
                    TextColor="White" />

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>