<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarRecoveryApp.Views.SyncSettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Configuración de sincronización">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Conexión con Pomerium"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Datos de conexión al portal remoto. El cookie de sesión se guarda cifrado en el dispositivo (SecureStorage) y nunca se muestra de vuelta en pantalla."
                FontSize="12"
                TextColor="Gray"
                HorizontalTextAlignment="Center" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <Border
                IsVisible="{Binding HasError}"
                Style="{StaticResource ErrorBanner}">
                <Label
                    Text="{Binding ErrorMessage}"
                    Style="{StaticResource ErrorBannerText}" />
            </Border>

            <Border
                IsVisible="{Binding HasSuccess}"
                Style="{StaticResource SuccessBanner}">
                <Label
                    Text="{Binding SuccessMessage}"
                    Style="{StaticResource SuccessBannerText}" />
            </Border>

            <Label
                Text="URL base"
                FontSize="13"
                TextColor="Gray" />
            <Entry
                Text="{Binding BaseUrl}"
                Placeholder="https://report-portal.oss-solutions.local:2443" />

            <Label
                Text="CustomerId"
                FontSize="13"
                TextColor="Gray" />
            <Entry
                Text="{Binding CustomerId}"
                Placeholder="13c5ac81-74bc-4f6c-b8a2-a0bb045b6dc9" />

            <BoxView HeightRequest="1" Color="#DDDDDD" Margin="0,8" />

            <Label
                Text="Sesión"
                FontSize="18"
                FontAttributes="Bold" />

            <Label
                Text="{Binding SessionStatusText}"
                FontSize="13"
                TextColor="Gray" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    Text="Iniciar sesión"
                    Command="{Binding SignInCommand}" />

                <Button
                    Grid.Column="1"
                    Text="Cerrar sesión"
                    Command="{Binding SignOutCommand}"
                    IsVisible="{Binding HasProgrammaticSession}" />
            </Grid>

            <BoxView HeightRequest="1" Color="#DDDDDD" Margin="0,8" />

            <Label
                Text="Cookie _pomerium (solo como respaldo; si inicia sesión arriba, se usa esa sesión)"
                FontSize="13"
                TextColor="Gray" />
            <Entry
                Text="{Binding PomeriumCookie}"
                Placeholder="Pegar valor del cookie de sesión"
                IsPassword="True" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    Text="Eliminar configuración"
                    Command="{Binding ClearCommand}"
                    Style="{StaticResource DangerButton}" />

                <Button
                    Grid.Column="1"
                    Text="Guardar"
                    Command="{Binding SaveCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
