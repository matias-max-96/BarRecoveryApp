<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarRecoveryApp.Views.AdminHomePage"
             Title="Administración Taller">

    <ScrollView>

        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Menú Administración"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>

            <Label
                Text="Gestión de usuarios, Plantas, Barras, Actividades, Insumos, atributos técnicos y políticas de recuperación"
                FontSize="10"
                TextColor="Gray"
                HorizontalTextAlignment="Center"/>

            <Button Text="Usuarios"
                    Clicked="OnUsersClicked"/>
            <Button Text="Plantas"
                    Clicked="OnPlantsClicked"/>
            <Button Text="Tipos de barras"
                    Clicked="OnBarTypesClicked"/>
            <Button Text="Insumos"/>
            <Button Text="Atributos técnicos"/>
            <Button Text="Políticas de recuperación"/>
            <Button Text="Exportaciones"/>
            <Button Text="Sincronización"/>

            <Button
                Text="Cerrar sesión"
                Clicked="OnLogoutClicked"
                BackgroundColor="#DC3545"
                TextColor="WhiteSmoke"/>


        </VerticalStackLayout>
        
    </ScrollView>
    
</ContentPage>