<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="BarRecoveryApp.Views.AdminHomePage"
             Title="Administración Taller">

    <ScrollView>

        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Menú Administración"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center"/>

            <Label
                Text="Gestión de usuarios, Plantas, Barras, Actividades, Insumos, atributos técnicos y políticas de recuperación"
                FontSize="10"
                TextColor="Gray"
                HorizontalTextAlignment="Center"/>

            <Button Text="Usuarios"
                    Clicked="OnUsersClicked"/>
            <Button Text="Plantas"
                    Clicked="OnPlantsClicked"/>
            <Button Text="Tipos de barras"
                    Clicked="OnBarTypesClicked"/>
            <Button Text="Actividades"
                    Clicked="OnActivitiesClicked" />
            <Button Text="Insumos"
                    Clicked="OnSuppliesClicked"/>
            <Button Text="Atributos técnicos"
                    Clicked="OnBarAttributeDefinitionsClicked"/>
            <Button Text="Políticas de recuperación"
                    Clicked="OnBarRecoveryPoliciesClicked"/>
            <Button Text="Barras"
                    Clicked="OnBarsClicked"/>
            <Button Text="Importar Barras .csv"
                    Clicked="OnBarImportClicked"/>
            <Button Text="Resumen operacional"
                    Clicked="OnDashboardClicked"/>
            <Button Text="Exportar reportes"
                    Clicked="OnReportExportClicked"/>
            <Button Text="Registros de operadores faltantes"
                    Clicked="OnMissingWorkReportsClicked"/>
            <Button 
                    x:Name="AuditLogButton"
                    Text="Exportar Auditoría"
                    Clicked="OnAuditLogClicked"
                    IsVisible="False"
                    BackgroundColor="#6F42C1"
                    TextColor="WhiteSmoke"/>

            <Button
                x:Name="SyncButton"
                Text="Sincronización"
                Clicked="OnSyncClicked"
                BackgroundColor="#0DCAF0"
                TextColor="Black"/>

            <Button
                Text="Configuración de sincronización"
                Clicked="OnSyncSettingsClicked"
                BackgroundColor="#20C997"
                TextColor="Black"/>

            <Button
                Text="Cerrar sesión"
                Clicked="OnLogoutClicked"
                BackgroundColor="#DC3545"
                TextColor="WhiteSmoke"/>


        </VerticalStackLayout>

    </ScrollView>

</ContentPage>