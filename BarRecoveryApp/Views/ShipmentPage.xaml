<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarRecoveryApp.Views.ShipmentPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Envíos">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Registro de Envío"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <Border
                IsVisible="{Binding HasError}"
                Padding="12"
                Stroke="#D9534F"
                StrokeThickness="1"
                BackgroundColor="White">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#B00020"
                    FontAttributes="Bold" />
            </Border>

            <Border
                IsVisible="{Binding HasSuccess}"
                Padding="12"
                Stroke="#2E7D32"
                StrokeThickness="1"
                BackgroundColor="White">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Label
                    Text="{Binding SuccessMessage}"
                    TextColor="#2E7D32"
                    FontAttributes="Bold" />
            </Border>

            <Label
                Text="Datos del envío"
                FontSize="20"
                FontAttributes="Bold" />

            <Entry
                Text="{Binding TransferOrder}"
                Placeholder="Orden de traslado" />

            <Entry
                Text="{Binding CustomerReference}"
                Placeholder="Referencia cliente / destino opcional" />

            <Entry
                Text="{Binding DispatchGuideNumber}"
                Placeholder="N° de guía de despacho (documento agencia externa)" />

            <BoxView HeightRequest="1" Color="#DDDDDD" Margin="0,8" />

            <Label
                Text="Filtros de búsqueda"
                FontSize="20"
                FontAttributes="Bold" />

            <Picker
                Title="Seleccione planta"
                ItemsSource="{Binding Plants}"
                SelectedItem="{Binding SelectedPlant}"
                ItemDisplayBinding="{Binding Name}" />

            <Picker
                Title="Seleccione tipo de barra"
                ItemsSource="{Binding BarTypes}"
                SelectedItem="{Binding SelectedBarType}"
                ItemDisplayBinding="{Binding Name}" />

            <Entry
                Text="{Binding SearchText}"
                Placeholder="Buscar por número, planta o tipo de barra" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <Button
                    Grid.Column="0"
                    Text="Limpiar filtros"
                    Command="{Binding ClearFiltersCommand}"
                    BackgroundColor="#6C757D"
                    TextColor="White" />

                <Button
                    Grid.Column="1"
                    Text="Buscar barras"
                    Command="{Binding SearchCommand}"
                    BackgroundColor="#0D6EFD"
                    TextColor="White" />

            </Grid>

            <Label
                Text="{Binding ResultCountText}"
                FontSize="13"
                TextColor="Gray" />

            <BoxView HeightRequest="1" Color="#DDDDDD" Margin="0,8" />

            <Label
                Text="Resultados de búsqueda"
                FontSize="20"
                FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding Bars}">
                <CollectionView.EmptyView>
                    <Label
                        Text="No hay barras listas para envío. Use los filtros y presione Buscar barras."
                        TextColor="Gray"
                        HorizontalTextAlignment="Center"
                        Margin="0,24" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="12"
                            Margin="0,4"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            BackgroundColor="White">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                                <CheckBox
                                    Grid.Column="0"
                                    IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                    CheckedChanged="OnBarCheckedChanged" />

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label
                                        Text="{Binding DisplayName}"
                                        FontAttributes="Bold"
                                        FontSize="16" />

                                    <Label
                                        Text="{Binding DetailText}"
                                        FontSize="13"
                                        TextColor="Gray" />
                                </VerticalStackLayout>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <BoxView HeightRequest="1" Color="#DDDDDD" Margin="0,8" />

            <Label
                Text="Barras seleccionadas para envío"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                Text="{Binding SelectedCountText}"
                FontSize="13"
                TextColor="Gray" />

            <CollectionView ItemsSource="{Binding SelectedBars}">
                <CollectionView.EmptyView>
                    <Label
                        Text="No hay barras seleccionadas."
                        TextColor="Gray"
                        HorizontalTextAlignment="Center"
                        Margin="0,12" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="12"
                            Margin="0,4"
                            Stroke="#198754"
                            StrokeThickness="1"
                            BackgroundColor="#F2FFF6">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">

                                <VerticalStackLayout Grid.Column="0" Spacing="4">
                                    <Label
                                        Text="{Binding DisplayName}"
                                        FontAttributes="Bold"
                                        FontSize="16" />

                                    <Label
                                        Text="{Binding DetailText}"
                                        FontSize="13"
                                        TextColor="Gray" />
                                </VerticalStackLayout>

                                <Button
                                    Grid.Column="1"
                                    Text="Quitar"
                                    Clicked="OnRemoveSelectedBarClicked"
                                    BackgroundColor="#DC3545"
                                    TextColor="White" />

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid
                ColumnDefinitions="*,*,*"
                RowDefinitions="Auto,Auto"
                ColumnSpacing="12"
                RowSpacing="12">

                <Button
                    Grid.Row="0"
                    Grid.Column="0"
                    Text="Limpiar selección"
                    Command="{Binding ClearSelectionCommand}"
                    BackgroundColor="#FFC107"
                    TextColor="Black" />

                <Button
                    Grid.Row="0"
                    Grid.Column="1"
                    Text="Limpiar todo"
                    Command="{Binding ClearAllCommand}"
                    BackgroundColor="#6C757D"
                    TextColor="White" />

                <Button
                    Grid.Row="0"
                    Grid.Column="2"
                    Text="Crear envío"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#198754"
                    TextColor="White" />

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    IsVisible="{Binding HasTechnicalReport}"
                    Padding="12"
                    Margin="0,8"
                    Stroke="#198754"
                    StrokeThickness="1"
                    BackgroundColor="#F2FFF6">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="8">

                        <Label
                            Text="Reporte técnico generado"
                            FontSize="18"
                            FontAttributes="Bold"
                            TextColor="#198754" />

                        <Label
                            Text="{Binding LastTechnicalReportFileName}"
                            FontSize="14"
                            TextColor="Gray" />

                        <Label
                            Text="{Binding LastTechnicalReportFilePath}"
                            FontSize="12"
                            TextColor="Gray"
                            LineBreakMode="CharacterWrap" />

                        <Button
                            Text="Compartir reporte técnico"
                            Command="{Binding ShareTechnicalReportCommand}"
                            BackgroundColor="#198754"
                            TextColor="White" />

                    </VerticalStackLayout>
                </Border>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>