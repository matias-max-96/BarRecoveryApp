<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarRecoveryApp.Views.RecoveryWorkReportsHistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mis registros recientes">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Mis Registros Recientes"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <Border
                IsVisible="{Binding HasError}"
                Padding="12"
                Stroke="#D9534F"
                StrokeThickness="1"
                BackgroundColor="White">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#B00020"
                    FontAttributes="Bold" />
            </Border>

            <CollectionView
                ItemsSource="{Binding Reports}"
                SelectedItem="{Binding SelectedReport, Mode=TwoWay}"
                SelectionMode="Single">

                <CollectionView.EmptyView>
                    <Label
                        Text="No existen registros de recuperación para este usuario."
                        TextColor="Gray"
                        HorizontalTextAlignment="Center"
                        Margin="0,24" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="12"
                            Margin="0,6"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            BackgroundColor="White">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="6">

                                <Label
                                    Text="{Binding WorkDateText}"
                                    FontAttributes="Bold"
                                    FontSize="16" />

                                <Label
                                    Text="{Binding ShiftName, StringFormat='Turno: {0}'}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Label
                                    Text="{Binding BarsWorkedCount, StringFormat='Barras trabajadas: {0}'}"
                                    FontSize="13" />

                                <Label
                                    Text="{Binding ActivitiesSummary, StringFormat='Actividades: {0}'}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Label
                                    Text="{Binding SuppliesSummary, StringFormat='Insumos: {0}'}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Label
                                    Text="{Binding Notes, StringFormat='Observaciones: {0}'}"
                                    FontSize="13"
                                    TextColor="Gray" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>