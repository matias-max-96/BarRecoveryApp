<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarRecoveryApp.Views.RecoveryRecordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Registrar recuperación">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Registrar Recuperación"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- ActivityIndicator quitado: bug de renderizado en Android,
                 ver LoginPage.xaml para el detalle. -->

            <Border
                IsVisible="{Binding HasError}"
                Style="{StaticResource ErrorBanner}">
                <Label
                    Text="{Binding ErrorMessage}"
                    Style="{StaticResource ErrorBannerText}" />
            </Border>

            <Border
                IsVisible="{Binding HasSuccess}"
                Style="{StaticResource SuccessBanner}">
                <Label
                    Text="{Binding SuccessMessage}"
                    Style="{StaticResource SuccessBannerText}" />
            </Border>

            <Label
                Text="Datos de actividad"
                FontSize="20"
                FontAttributes="Bold" />

            <Picker
                Title="Seleccione barra"
                ItemsSource="{Binding Bars}"
                SelectedItem="{Binding SelectedBar}"
                ItemDisplayBinding="{Binding BarNumber}" />

            <Picker
                Title="Seleccione actividad"
                ItemsSource="{Binding Activities}"
                SelectedItem="{Binding SelectedActivity}"
                ItemDisplayBinding="{Binding Name}" />

            <Label
                Text="Insumos utilizados"
                FontSize="20"
                FontAttributes="Bold" />

            <Picker
                Title="Seleccione insumo"
                ItemsSource="{Binding Supplies}"
                SelectedItem="{Binding SelectedSupply}"
                ItemDisplayBinding="{Binding Name}" />

            <Entry
                Text="{Binding Quantity}"
                Placeholder="Cantidad utilizada"
                Keyboard="Numeric" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    Text="Agregar insumo"
                    Command="{Binding AddSupplyCommand}" />

                <Button
                    Grid.Column="1"
                    Text="Quitar seleccionado"
                    Command="{Binding RemoveSupplyCommand}"
                    Style="{StaticResource DangerButton}" />
            </Grid>

            <CollectionView
                ItemsSource="{Binding UsedSupplies}"
                SelectedItem="{Binding SelectedSupplyEntry, Mode=TwoWay}"
                SelectionMode="Single">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="12"
                            Margin="0,4"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            BackgroundColor="White">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <Label
                                Text="{Binding DisplayText}"
                                FontAttributes="Bold" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label
                Text="Observación"
                FontSize="20"
                FontAttributes="Bold" />

            <Editor
                Text="{Binding Notes}"
                Placeholder="Observación del trabajo realizado"
                AutoSize="TextChanges"
                HeightRequest="100" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    Text="Limpiar"
                    Command="{Binding ClearCommand}"
                    Style="{StaticResource OutlineButton}" />

                <Button
                    Grid.Column="1"
                    Text="Guardar"
                    Command="{Binding SaveCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>