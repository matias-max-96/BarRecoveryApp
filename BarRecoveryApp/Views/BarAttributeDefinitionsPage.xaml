<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarRecoveryApp.Views.BarAttributeDefinitionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Atributos técnicos">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Gestión de Atributos Técnicos"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <Border
                IsVisible="{Binding HasError}"
                Padding="12"
                Stroke="#D9534F"
                StrokeThickness="1"
                BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#B00020"
                    FontAttributes="Bold" />
            </Border>

            <Border
                IsVisible="{Binding HasSuccess}"
                Padding="12"
                Stroke="#2E7D32"
                StrokeThickness="1"
                BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Label
                    Text="{Binding SuccessMessage}"
                    TextColor="#2E7D32"
                    FontAttributes="Bold" />
            </Border>

            <Label
                Text="Datos del atributo"
                FontSize="20"
                FontAttributes="Bold" />

            <Entry
                Text="{Binding Code}"
                Placeholder="Código ej: LARGO, PESO, ANGULO" />

            <Entry
                Text="{Binding Name}"
                Placeholder="Nombre ej: Largo, Peso, Ángulo" />

            <Picker
                Title="Tipo de dato"
                ItemsSource="{Binding DataTypes}"
                SelectedItem="{Binding SelectedDataType}"
                ItemDisplayBinding="{Binding Name}" />

            <Entry
                Text="{Binding Unit}"
                Placeholder="Unidad ej: mm, kg, °" />

            <Entry
                Text="{Binding DisplayOrder}"
                Placeholder="Orden visual ej: 1, 2, 3"
                Keyboard="Numeric" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox
                    IsChecked="{Binding IsRequired}" />
                <Label
                    Text="Obligatorio"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Label
                Text="Aplicación del atributo"
                FontSize="20"
                FontAttributes="Bold" />

            <Picker
                Title="Aplica a planta específica (opcional)"
                ItemsSource="{Binding Plants}"
                SelectedItem="{Binding SelectedPlant}"
                ItemDisplayBinding="{Binding Name}" />

            <Picker
                Title="Aplica a tipo de barra específico (opcional)"
                ItemsSource="{Binding BarTypes}"
                SelectedItem="{Binding SelectedBarType}"
                ItemDisplayBinding="{Binding Name}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    Text="Nuevo"
                    Command="{Binding NewCommand}"
                    BackgroundColor="#6C757D"
                    TextColor="White" />

                <Button
                    Grid.Column="1"
                    Text="{Binding SaveButtonText}"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="#0D6EFD"
                    TextColor="White" />
            </Grid>

            <BoxView HeightRequest="1" Color="#DDDDDD" Margin="0,12" />

            <Label
                Text="Atributos existentes"
                FontSize="20"
                FontAttributes="Bold" />

            <CollectionView
                ItemsSource="{Binding Definitions}"
                SelectedItem="{Binding SelectedDefinition, Mode=TwoWay}"
                SelectionMode="Single">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="12"
                            Margin="0,4"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            BackgroundColor="White">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="{Binding Name}"
                                    FontAttributes="Bold"
                                    FontSize="16" />

                                <Label
                                    Text="{Binding Code}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Label
                                    Text="{Binding Unit, StringFormat='Unidad: {0}'}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Label
                                    Text="{Binding DisplayOrder, StringFormat='Orden: {0}'}"
                                    FontSize="13" />

                                <Label
                                    Text="{Binding IsRequired, StringFormat='Obligatorio: {0}'}"
                                    FontSize="13" />

                                <Label
                                    Text="{Binding IsActive, StringFormat='Activo: {0}'}"
                                    FontSize="13" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button
                Text="Activar / Desactivar seleccionado"
                Command="{Binding ToggleActiveCommand}"
                BackgroundColor="#FFC107"
                TextColor="Black" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>