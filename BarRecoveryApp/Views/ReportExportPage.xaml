<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarRecoveryApp.Views.ReportExportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Exportar reportes">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Exportar Reportes"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Genera un archivo Excel con una hoja por operador y columnas por fecha."
                FontSize="14"
                TextColor="Gray"
                HorizontalTextAlignment="Center" />

            <!-- ActivityIndicator quitado: bug de renderizado en Android,
                 ver LoginPage.xaml para el detalle. -->

            <Border
                IsVisible="{Binding HasError}"
                Style="{StaticResource ErrorBanner}">

                <Label
                    Text="{Binding ErrorMessage}"
                    Style="{StaticResource ErrorBannerText}" />
            </Border>

            <Border
                IsVisible="{Binding HasSuccess}"
                Style="{StaticResource SuccessBanner}">

                <Label
                    Text="{Binding SuccessMessage}"
                    Style="{StaticResource SuccessBannerText}" />
            </Border>

            <Label
                Text="Rango de fechas"
                FontSize="20"
                FontAttributes="Bold" />

            <VerticalStackLayout Spacing="8">

                <Label Text="Desde" />

                <DatePicker
                    Date="{Binding FromDate}" />

                <Label Text="Hasta" />

                <DatePicker
                    Date="{Binding ToDate}" />

            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <Button
                    Grid.Column="0"
                    Text="Limpiar"
                    Command="{Binding ClearCommand}"
                    Style="{StaticResource OutlineButton}" />

                <Button
                    Grid.Column="1"
                    Text="Exportar producción"
                    Command="{Binding ExportProductionCommand}" />

            </Grid>

            <BoxView
                HeightRequest="1"
                Color="#DDDDDD"
                Margin="0,8" />

            <Label
                Text="Último archivo generado"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                Text="{Binding LastFileName}"
                FontSize="14"
                TextColor="Gray" />

            <Button
                Text="Compartir archivo generado"
                Command="{Binding ShareLastFileCommand}"
                Style="{StaticResource SecondaryButton}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>