<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarRecoveryApp.Views.RecoveryHomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Recuperación">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Menú Recuperación"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Desde aquí el operario registra actividades de recuperación, insumos utilizados y observaciones."
                FontSize="15"
                TextColor="Gray"
                HorizontalTextAlignment="Center" />

            <Button Text="Registrar recuperación"
                    Clicked="OnRecoveryWorkReportClicked"/>
            <Button Text="Mis registros recientes"
                    Clicked="OnMyRecoveryReportsClicked"/>
            <Button Text="Consultar barra" />

            <Button
                Text="Cerrar sesión"
                Clicked="OnLogoutClicked"
                BackgroundColor="#DC3545"
                TextColor="WhiteSmoke"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>