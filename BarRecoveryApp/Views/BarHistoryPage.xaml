<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarRecoveryApp.Views.BarHistoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Historial de barra">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Historial de Barra"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <!-- Errores -->
            <Border
                IsVisible="{Binding HasError}"
                Padding="12"
                Margin="0,4"
                Stroke="#D9534F"
                StrokeThickness="1"
                BackgroundColor="White">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#B00020"
                    FontAttributes="Bold" />
            </Border>

            <!-- Filtros -->
            <Label
                Text="Filtros de búsqueda"
                FontSize="20"
                FontAttributes="Bold" />

            <Picker
                Title="Seleccione planta"
                ItemsSource="{Binding Plants}"
                SelectedItem="{Binding SelectedPlant}"
                ItemDisplayBinding="{Binding Name}" />

            <Picker
                Title="Seleccione tipo de barra"
                ItemsSource="{Binding BarTypes}"
                SelectedItem="{Binding SelectedBarType}"
                ItemDisplayBinding="{Binding Name}" />

            <Entry
                Text="{Binding SearchText}"
                Placeholder="Buscar por número de barra" />

            <HorizontalStackLayout Spacing="8">
                <CheckBox
                    IsChecked="{Binding IncludeInactive}" />

                <Label
                    Text="Incluir barras inactivas"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <Button
                    Grid.Column="0"
                    Text="Limpiar"
                    Command="{Binding ClearCommand}"
                    BackgroundColor="#6C757D"
                    TextColor="White" />

                <Button
                    Grid.Column="1"
                    Text="Buscar barras"
                    Command="{Binding SearchCommand}"
                    BackgroundColor="#0D6EFD"
                    TextColor="White" />

            </Grid>

            <Label
                Text="{Binding ResultCountText}"
                FontSize="13"
                TextColor="Gray" />

            <BoxView
                HeightRequest="1"
                Color="#DDDDDD"
                Margin="0,8" />

            <!-- Resultados búsqueda -->
            <Label
                Text="Barras encontradas"
                FontSize="20"
                FontAttributes="Bold" />

            <CollectionView
                ItemsSource="{Binding Bars}"
                SelectedItem="{Binding SelectedBar, Mode=TwoWay}"
                SelectionMode="Single">

                <CollectionView.EmptyView>
                    <Label
                        Text="No hay barras para mostrar. Use los filtros y presione Buscar barras."
                        TextColor="Gray"
                        HorizontalTextAlignment="Center"
                        Margin="0,24" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="12"
                            Margin="0,4"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            BackgroundColor="White">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="{Binding DisplayName}"
                                    FontAttributes="Bold"
                                    FontSize="16" />

                                <Label
                                    Text="{Binding DetailText}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Label
                                    Text="{Binding IsActive, StringFormat='Activa: {0}'}"
                                    FontSize="13"
                                    TextColor="Gray" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button
                Text="Cargar historial de barra seleccionada"
                Command="{Binding LoadHistoryCommand}"
                BackgroundColor="#198754"
                TextColor="White" />

            <BoxView
                HeightRequest="1"
                Color="#DDDDDD"
                Margin="0,8" />

            <!-- Detalle historial -->
            <VerticalStackLayout
                IsVisible="{Binding HasHistory}"
                Spacing="16">

                <Label
                    Text="Detalle de barra"
                    FontSize="20"
                    FontAttributes="Bold" />

                <Border
                    Padding="12"
                    Stroke="#0D6EFD"
                    StrokeThickness="1"
                    BackgroundColor="#EAF2FF">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="4">

                        <Label
                            Text="{Binding History.HeaderText}"
                            FontAttributes="Bold"
                            FontSize="18"
                            TextColor="#0D6EFD" />

                        <Label
                            Text="{Binding History.SummaryText}"
                            FontSize="14"
                            TextColor="Gray" />

                        <Label
                            Text="{Binding History.IsDisposed, StringFormat='Dada de baja: {0}'}"
                            FontSize="13" />

                    </VerticalStackLayout>
                </Border>

                <!-- Inspecciones -->
                <Label
                    Text="Inspecciones de calidad"
                    FontSize="20"
                    FontAttributes="Bold" />

                <CollectionView ItemsSource="{Binding History.Inspections}">
                    <CollectionView.EmptyView>
                        <Label
                            Text="No hay inspecciones registradas para esta barra."
                            TextColor="Gray"
                            HorizontalTextAlignment="Center"
                            Margin="0,12" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="12"
                                Margin="0,4"
                                Stroke="#DDDDDD"
                                StrokeThickness="1"
                                BackgroundColor="White">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="{Binding InspectionAtText}"
                                        FontAttributes="Bold"
                                        FontSize="15" />

                                    <Label
                                        Text="{Binding InspectorName, StringFormat='Inspector: {0}'}"
                                        FontSize="13"
                                        TextColor="Gray" />

                                    <Label
                                        Text="{Binding RecoveryCountAtInspection, StringFormat='Recuperaciones en inspección: {0}'}"
                                        FontSize="13" />

                                    <Label
                                        Text="{Binding ResultText, StringFormat='Resultado: {0}'}"
                                        FontSize="13"
                                        TextColor="Gray" />

                                    <Label
                                        Text="{Binding Notes, StringFormat='Observaciones: {0}'}"
                                        FontSize="13"
                                        TextColor="Gray" />

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Envíos -->
                <Label
                    Text="Envíos"
                    FontSize="20"
                    FontAttributes="Bold" />

                <CollectionView ItemsSource="{Binding History.Shipments}">
                    <CollectionView.EmptyView>
                        <Label
                            Text="No hay envíos registrados para esta barra."
                            TextColor="Gray"
                            HorizontalTextAlignment="Center"
                            Margin="0,12" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="12"
                                Margin="0,4"
                                Stroke="#DDDDDD"
                                StrokeThickness="1"
                                BackgroundColor="White">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="{Binding ShippedAtText}"
                                        FontAttributes="Bold"
                                        FontSize="15" />

                                    <Label
                                        Text="{Binding TransferOrder, StringFormat='Orden traslado: {0}'}"
                                        FontSize="13"
                                        TextColor="Gray" />

                                    <Label
                                        Text="{Binding CustomerReference, StringFormat='Referencia cliente: {0}'}"
                                        FontSize="13"
                                        TextColor="Gray" />

                                    <Label
                                        Text="{Binding ResponsibleName, StringFormat='Responsable: {0}'}"
                                        FontSize="13"
                                        TextColor="Gray" />

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Retornos -->
                <Label
                    Text="Recepciones de retorno"
                    FontSize="20"
                    FontAttributes="Bold" />

                <CollectionView ItemsSource="{Binding History.Returns}">
                    <CollectionView.EmptyView>
                        <Label
                            Text="No hay retornos registrados para esta barra."
                            TextColor="Gray"
                            HorizontalTextAlignment="Center"
                            Margin="0,12" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Padding="12"
                                Margin="0,4"
                                Stroke="#DDDDDD"
                                StrokeThickness="1"
                                BackgroundColor="White">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="4">

                                    <Label
                                        Text="{Binding ReceivedAtText}"
                                        FontAttributes="Bold"
                                        FontSize="15" />

                                    <Label
                                        Text="{Binding ReturnDocument, StringFormat='Documento retorno: {0}'}"
                                        FontSize="13"
                                        TextColor="Gray" />

                                    <Label
                                        Text="{Binding ResponsibleName, StringFormat='Responsable: {0}'}"
                                        FontSize="13"
                                        TextColor="Gray" />

                                    <Label
                                        Text="{Binding Notes, StringFormat='Observaciones: {0}'}"
                                        FontSize="13"
                                        TextColor="Gray" />

                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>