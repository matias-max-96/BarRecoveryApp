<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarRecoveryApp.Views.BarImportPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Importar barras">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Importación Masiva de Barras"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <Label
                Text="Seleccione un archivo CSV con las columnas BarNumber, PlantCode y BarTypeCode."
                FontSize="14"
                TextColor="Gray"
                HorizontalTextAlignment="Center" />

            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                HorizontalOptions="Center" />

            <!-- Error general -->
            <Border
                IsVisible="{Binding HasError}"
                Padding="12"
                Margin="0,4"
                Stroke="#D9534F"
                StrokeThickness="1"
                BackgroundColor="White">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#B00020"
                    FontAttributes="Bold" />
            </Border>

            <!-- Éxito -->
            <Border
                IsVisible="{Binding HasSuccess}"
                Padding="12"
                Margin="0,4"
                Stroke="#2E7D32"
                StrokeThickness="1"
                BackgroundColor="White">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <Label
                    Text="{Binding SuccessMessage}"
                    TextColor="#2E7D32"
                    FontAttributes="Bold" />
            </Border>

            <Label
                Text="Formato esperado"
                FontSize="20"
                FontAttributes="Bold" />

            <Border
                Padding="12"
                Stroke="#DDDDDD"
                StrokeThickness="1"
                BackgroundColor="#F8F9FA">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="4">

                    <Label
                        Text="BarNumber,PlantCode,BarTypeCode"
                        FontFamily="monospace"
                        FontSize="13" />

                    <Label
                        Text="BARRA-001,ANA,60"
                        FontFamily="monospace"
                        FontSize="13" />

                    <Label
                        Text="BARRA-002,VALDIVIA,90"
                        FontFamily="monospace"
                        FontSize="13" />

                    <Label
                        Text="MAPA-001,MAPA,MAPA"
                        FontFamily="monospace"
                        FontSize="13" />

                </VerticalStackLayout>
            </Border>

            <Label
                Text="Archivo seleccionado"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                Text="{Binding SelectedFileName}"
                FontSize="14"
                TextColor="Gray" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">

                <Button
                    Grid.Column="0"
                    Text="Limpiar"
                    Command="{Binding ClearCommand}"
                    BackgroundColor="#6C757D"
                    TextColor="White" />

                <Button
                    Grid.Column="1"
                    Text="Seleccionar e importar"
                    Command="{Binding PickAndImportCommand}"
                    BackgroundColor="#0D6EFD"
                    TextColor="White" />

            </Grid>

            <BoxView
                HeightRequest="1"
                Color="#DDDDDD"
                Margin="0,8" />

            <Label
                Text="Resumen"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                Text="{Binding SummaryText}"
                FontSize="14"
                TextColor="Gray" />

            <Label
                Text="Errores / advertencias"
                FontSize="20"
                FontAttributes="Bold" />

            <CollectionView ItemsSource="{Binding Errors}">
                <CollectionView.EmptyView>
                    <Label
                        Text="No hay errores para mostrar."
                        TextColor="Gray"
                        HorizontalTextAlignment="Center"
                        Margin="0,12" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="12"
                            Margin="0,4"
                            Stroke="#D9534F"
                            StrokeThickness="1"
                            BackgroundColor="White">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="4">

                                <Label
                                    Text="{Binding RowNumber, StringFormat='Fila: {0}'}"
                                    FontAttributes="Bold"
                                    FontSize="14"
                                    TextColor="#B00020" />

                                <Label
                                    Text="{Binding BarNumber, StringFormat='Barra: {0}'}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Label
                                    Text="{Binding Message}"
                                    FontSize="13"
                                    TextColor="#B00020" />

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>