<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="BarRecoveryApp.Views.BarsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Barras">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label
                Text="Gestión de Barras"
                FontSize="26"
                FontAttributes="Bold"
                HorizontalOptions="Center" />

            <!-- ActivityIndicator quitado: bug de renderizado en Android,
                 ver LoginPage.xaml para el detalle. -->

            <Border
                IsVisible="{Binding HasError}"
                Style="{StaticResource ErrorBanner}">
                <Label
                    Text="{Binding ErrorMessage}"
                    Style="{StaticResource ErrorBannerText}" />
            </Border>

            <Border
                IsVisible="{Binding HasSuccess}"
                Style="{StaticResource SuccessBanner}">
                <Label
                    Text="{Binding SuccessMessage}"
                    Style="{StaticResource SuccessBannerText}" />
            </Border>

            <Label
                Text="Datos de barra"
                FontSize="20"
                FontAttributes="Bold" />

            <Entry
                Text="{Binding BarNumber}"
                Placeholder="Número identificador de barra" />
            <Label
                Text="El número puede repetirse si cambia la planta o el tipo de barra."
                FontSize="12"
                TextColor="Gray"/>

            <Picker
                Title="Seleccione planta"
                ItemsSource="{Binding Plants}"
                SelectedItem="{Binding SelectedPlant}"
                ItemDisplayBinding="{Binding Name}" />

            <Picker
                Title="Seleccione tipo de barra"
                ItemsSource="{Binding BarTypes}"
                SelectedItem="{Binding SelectedBarType}"
                ItemDisplayBinding="{Binding Name}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button
                    Grid.Column="0"
                    Text="Nueva"
                    Command="{Binding NewCommand}"
                    Style="{StaticResource OutlineButton}" />

                <Button
                    Grid.Column="1"
                    Text="{Binding SaveButtonText}"
                    Command="{Binding SaveCommand}" />
            </Grid>

            <BoxView HeightRequest="1" Color="#DDDDDD" Margin="0,12" />

            <Label
                Text="Barras registradas"
                FontSize="20"
                FontAttributes="Bold" />

            <CollectionView
                ItemsSource="{Binding Bars}"
                SelectedItem="{Binding SelectedBar, Mode=TwoWay}"
                SelectionMode="Single">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Padding="12"
                            Margin="0,4"
                            Stroke="#DDDDDD"
                            StrokeThickness="1"
                            BackgroundColor="White">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="4">
                                <Label
                                    Text="{Binding DisplayName}"
                                    FontAttributes="Bold"
                                    FontSize="16" />

                                <Label
                                    Text="{Binding PlantName, StringFormat='Planta: {0}'}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Label
                                    Text="{Binding BarTypeName, StringFormat='Tipo: {0}'}"
                                    FontSize="13"
                                    TextColor="Gray" />

                                <Label
                                    Text="{Binding StatusName, StringFormat='Estado: {0}'}"
                                    FontSize="13" />

                                <Label
                                    Text="{Binding RecoveryCount, StringFormat='Recuperaciones: {0}'}"
                                    FontSize="13" />

                                <Label
                                    Text="{Binding IsDisposedText, StringFormat='Dada de baja: {0}'}"
                                    FontSize="13" />

                                <Label
                                    Text="{Binding IsActiveText, StringFormat='Activa: {0}'}"
                                    FontSize="13" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button
                Text="Activar / Desactivar seleccionada"
                Command="{Binding ToggleActiveCommand}"
                Style="{StaticResource SecondaryButton}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>